    "difference_percent": float,
    "assessment": string
  },
  "market_insights": {
    "demand_level": string ("high" | "moderate" | "low"),
    "supply_level": string ("high" | "moderate" | "low"),
    "trend": string ("appreciating" | "stable" | "depreciating"),
    "reasoning": string
  },
